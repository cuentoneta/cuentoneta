{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist/out-tsc",
		"types": ["node"],
		"rootDir": "src"
	},
	"files": ["src/main.ts", "src/main.server.ts", "src/server.ts"],
	"include": ["src/**/*.d.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "**/*.stories.ts", "**/*.stories.js"]
}
