# See http://help.github.com/ignore-files/ for more about ignoring files.

# environment config de Angular
/src/app/environments/*

# env variables
.env
.env.*
# compiled output
dist
tmp
# checkout de la rama de métricas, que el job de indexado crea acá y reproducir en local también deja
.metrics/
/out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Tools & frameworks
.angular
.nx
.vercel
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Claude — se versiona la config de equipo (.claude/{references,agents,skills,settings.json}).
# Quedan fuera los datos personales/locales y el almacenamiento interno de git worktrees.
.claude/settings.local.json
.claude/worktrees/
# Formato de exportación del cliente de escritorio: un ZIP que Claude Code no sabe cargar. La
# skill se versiona extraída a su directorio; el ZIP es un intermediario que envejece aparte.
.claude/skills/**/*.skill

# Artefactos de Playwright MCP (snapshots/logs de inspección). No versionar: además, al
# vivir dentro del repo, el escaneo de contenido de Tailwind v4 los vigila y su escritura
# en vivo dispara rebuilds en bucle del dev server (HMR) si no se ignoran.
.playwright-mcp/

# Material de referencia generado, ya no regenerable: el script que lo producía se dio de baja.
/tools/author-bios/

# Exportaciones de dataset de Sanity
/cms/*.tar.gz

# Plan de trabajo local (no se versiona)
/PLAN.md

# Planes y artefactos de orquestación de Claude (no se versionan)
/workflows
# Artefactos del skill issue-workflow (workspace/<numero>/{PLAN,CODE_REVIEW,SECURITY_REVIEW}.md por issue; ruta plana como fallback ad-hoc)
/workspace

# Donde el barrido de worktrees deposita los artefactos que rescata antes de una remoción, para que
# no se pierdan con el directorio que los contenía.
/workspace-archivado

# Grabaciones sueltas de referencia en scripts/
scripts/*.m4a
scripts/*.mp4

# Info incremental de TypeScript (regenerable por tsc -b)
*.tsbuildinfo

# Claves de service accounts de Google (nunca versionar). Ningún glob las cubre todas: la consola
# de Cloud IAM exporta con el nombre `<project-id>-<hash>.json`, que depende del proyecto, y `gcloud`
# acepta cualquier nombre. Por eso la defensa primaria es guardar la key FUERA del árbol del repo y
# apuntarle con GSC_SERVICE_ACCOUNT_KEY_PATH; lo de abajo es la red de contención para los nombres
# previsibles, más un directorio por si se prefiere tenerla cerca.
*.iam.gserviceaccount.com.json
*service-account*.json
gsc-key.json
/.secrets/
