{
	"name": "@cuentoneta/app",
	"type": "module",
	"version": "2.11.5",
	"imports": {
		"#tailwind-theme": "./src/tailwind.css"
	},
	"license": "CC BY-NC-SA 4.0",
	"engines": {
		"node": "^24.18.0"
	},
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"preinstall": "npx only-allow@1.2.2 pnpm",
		"postinstall": "pnpm ops config",
		"prebuild": "pnpm ops config",
		"postbuild": "node scripts/fix-index-file-name.mjs",
		"dev": "ng serve --configuration development",
		"build": "ng build --configuration production",
		"ops": "node --import tsx --env-file-if-exists=.env ./scripts/ops/run.ts",
		"storybook": "storybook dev -p 4400 --no-open --no-version-updates",
		"prestorybook:build": "pnpm ops config",
		"storybook:build": "storybook build -o dist/storybook/cuentoneta",
		"lint": "eslint ./src ./e2e ./cms ./scripts ./tools",
		"stylelint": "stylelint \"src/**/*.css\" --report-needless-disables",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test",
		"sanity:dev": "pnpm -C cms run dev",
		"sanity:build": "pnpm -C cms run build",
		"sanity:test": "pnpm -C cms run test",
		"sanity:typecheck": "pnpm -C cms run typecheck",
		"sanity:extract-schema": "pnpm -C cms run extract-schema",
		"sanity:run-typegen-generator": "pnpm -C cms run typegen",
		"prepare": "husky"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "22.3.0",
		"@angular/build": "22.3.0",
		"@angular/common": "22.3.0",
		"@angular/compiler": "22.3.0",
		"@angular/core": "22.3.0",
		"@angular/forms": "22.3.0",
		"@angular/platform-browser": "22.3.0",
		"@angular/platform-browser-dynamic": "22.3.0",
		"@angular/platform-server": "22.3.0",
		"@angular/router": "22.3.0",
		"@angular/ssr": "22.3.0",
		"@angular/youtube-player": "22.3.0",
		"@floating-ui/dom": "^1.8.0",
		"@hono/node-server": "^2.1.6",
		"@hono/zod-validator": "^0.9.1",
		"@microsoft/clarity": "^1.0.2",
		"@ng-icons/core": "^36.1.0",
		"@ng-icons/font-awesome": "^36.1.0",
		"@ng-icons/simple-icons": "^36.1.0",
		"@sanity/client": "^8.15.0",
		"@sanity/image-url": "^2.1.1",
		"date-fns": "^4.4.0",
		"esbuild": "0.28.2",
		"groq": "^6.22.0",
		"hono": "^4.13.17",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-breaks": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"rxjs": "~7.8.1",
		"satori": "^0.63.2",
		"satori-html": "^0.3.2",
		"tslib": "^2.9.1",
		"unified": "^11.0.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "2.9.7",
		"@analogjs/vitest-angular": "2.9.7",
		"@angular/cli": "22.3.0",
		"@angular/compiler-cli": "22.3.0",
		"@angular/language-service": "22.3.0",
		"@eslint/js": "^10.0.1",
		"@googleapis/searchconsole": "^11.0.1",
		"@playwright/test": "^1.65.0",
		"@storybook/addon-docs": "10.6.7",
		"@storybook/angular-vite": "10.6.7",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/angular": "^19.6.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/user-event": "^14.6.8",
		"@types/estree": "^1.0.10",
		"@types/jsonld": "^1.5.15",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "8.73.0",
		"@typescript-eslint/parser": "8.73.0",
		"@typescript-eslint/utils": "8.73.0",
