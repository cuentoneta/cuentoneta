		"eslint-plugin-unicorn": "^77.0.0",
		"globals": "17.14.0",
		"groq-js": "^2.0.1",
		"happy-dom": "^20.14.6",
		"husky": "^9.1.7",
		"jsonld": "^9.0.0",
		"node-html-parser": "^9.0.7",
		"only-allow": "^1.2.2",
		"postcss": "8.5.32",
