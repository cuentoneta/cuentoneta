		"slugify": "^1.6.9",
		"storybook": "10.6.7",
		"stylelint": "^16.26.1",
		"stylelint-config-recommended": "^17.0.0",
		"stylelint-config-standard": "^39.0.1",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
