{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist/out-tsc",
		"module": "preserve",
		"target": "es2022",
		"types": ["vitest/globals", "node"],
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"rootDir": "."
	},
	"files": ["src/test-setup.ts"],
	// e2e/_utils y scripts entran acá porque sus specs corren bajo Vitest: vite-tsconfig-paths solo
	// aplica los `paths` a los archivos que un proyecto incluye, y sin esto sus aliases no resuelven ahí.
	"include": [
		"vitest.config.ts",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/*.d.ts",
		"src/test-utils.ts",
		"e2e/_utils/**/*.ts",
		"scripts/**/*.ts"
	]
}
