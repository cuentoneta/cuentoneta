{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"emitDecoratorMetadata": false,
		"target": "es2022",
		"module": "preserve",
		"lib": ["dom", "es2022"],
		"paths": {
			"@api/*": ["./src/api/*"],
			"@app-utils/*": ["./src/app/utils/*"],
			"@components/*": ["./src/app/components/*"],
			"@middleware/*": ["./src/api/_middleware/*"],
			"@mocks/*": ["./src/mocks/*"],
			"@models/*": ["./src/models/*"],
			"@queries/*": ["./src/api/_queries/*"],
			"@schemas/*": ["./src/api/schemas/*"],
			"@utils/*": ["./src/utils/*"],
			"@sanity-types": ["./src/sanity/types.ts"],
			"@test-utils": ["./src/test-utils.ts"],
			"@testing/*": ["./src/testing/*"]
		},
		"isolatedModules": true,
		// El compilador, no solo el linter, rechaza un import de solo-tipo sin `type`; exige
		// `@typescript-eslint/no-import-type-side-effects`, porque `import { type A }` deja de borrarse.
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"strict": true
	},
	"files": [],
	"include": [],
	"references": [
		{
			"path": "./tsconfig.app.json"
		},
		{
			"path": "./tsconfig.spec.json"
		},
		{
			"path": "./tsconfig.editor.json"
		},
		{
			"path": "./.storybook/tsconfig.json"
		}
	],
	"compileOnSave": false,
	"exclude": ["node_modules", "tmp"],
	"angularCompilerOptions": {
		"enableI18nLegacyMessageIdFormat": false,
		"strictInjectionParameters": true,
		"strictInputAccessModifiers": true,
		"typeCheckHostBindings": true,
		"strictTemplates": true,
		"strictUnclaimedEventNames": true
	}
}
