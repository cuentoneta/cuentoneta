{
	"name": "@cuentoneta/app",
	"$schema": "node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "./src",
	"prefix": "cuentoneta",
	"tags": [],
	"targets": {
		"eslint:lint": {
			"command": "eslint ./src ./e2e ./cms ./scripts ./tools",
			"cache": true,
			"inputs": ["default", "{workspaceRoot}/cms/**/*"]
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p tsconfig.typecheck.json --noEmit"
			}
		}
	}
}
